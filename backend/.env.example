PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/messcast
JWT_SECRET=replace_with_a_long_random_secret_64_chars_minimum
STORAGE_ALERT_MB=500
NODE_ENV=development

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=MessCast <your-gmail@gmail.com>

# Deep-link scheme (matches app.json "scheme")
APP_SCHEME=messcast

# ── OTP Provider ──────────────────────────────────────────────────────────────
# twofactor → uses 2Factor.in for SMS OTP
# firebase  → mobile handles OTP via Firebase SDK
OTP_PROVIDER=twofactor

# Sign up at https://2factor.in → Dashboard → API → copy key
TWOFACTOR_API_KEY=your-2factor-api-key

# Set true to skip SMS and print OTP in terminal (dev only)
OTP_DEV_BYPASS=false

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
